<configuration>
    <input>
        <net-file value="../net/corridor.net.xml"/>
        <route-files value="base.rou.xml,surge.rou.xml"/>
        <additional-files value="../net/tls_programs.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1"/>
    </time>
    <processing>
        <time-to-teleport value="-1"/>
    </processing>
    <report>
        <no-step-log value="true"/>
        <no-warnings value="false"/>
    </report>
</configuration>
