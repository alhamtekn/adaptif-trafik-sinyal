# cp .env.example .env  (Windows: copy .env.example .env)

# --- Kafka ---
KAFKA_BOOTSTRAP=kafka:9092
TOPIC_RAW=traffic-raw
TOPIC_METRICS=tls-metrics
TOPIC_COMMANDS=signal-commands
TOPIC_APPLIED=control-applied

# --- Koşu (run) ayarları: run_experiments.py bunları her koşu için ezer ---
SCENARIO=surge
CONTROL_MODE=adaptive
SEED=1
SIM_END=3600
# Simülasyon gerçek zamandan kaç kat hızlı ilerlesin (1 sim-sn = 1/SIM_SPEEDUP gerçek sn)
SIM_SPEEDUP=5

# --- Spark pencereleri (GERÇEK saniye). SIM_SPEEDUP=5 iken 24 sn = 120 simülasyon saniyesi ---
# Pencere sinyal çevriminden (90 sim-sn = 18 gerçek sn) uzun olmalı, yoksa ölçümler çevrim fazına göre dalgalanır
WINDOW=24 seconds
SLIDE=6 seconds
WATERMARK=6 seconds
TRIGGER=2 seconds

# --- ClickHouse ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=traffic
CLICKHOUSE_USER=traffic
CLICKHOUSE_PASSWORD=traffic

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Bilgisayarda doluysa .env icinde degistirin
GRAFANA_PORT=3000
CLICKHOUSE_HTTP_PORT=8123
