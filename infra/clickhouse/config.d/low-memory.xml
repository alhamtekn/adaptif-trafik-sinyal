<!-- Dizüstü için düşük bellek ayarları. ClickHouse varsayılanları sunucu içindir. -->
<clickhouse>
    <max_server_memory_usage_to_ram_ratio>0.75</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>134217728</mark_cache_size>
    <index_mark_cache_size>33554432</index_mark_cache_size>
    <uncompressed_cache_size>16777216</uncompressed_cache_size>
    <!-- Bu projede kullanılmayan sistem log tabloları: sürekli yazma ve bellek tüketir -->
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <query_thread_log remove="1"/>
    <part_log remove="1"/>
    <processors_profile_log remove="1"/>
    <text_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
</clickhouse>
